# Ignore macOS system files
.DS_Store

# Deployment handoff policy: keep source and small reports, never binaries,
# checkpoints, datasets, generated evaluation trees, or local build state.
**/artifacts/
**/artifacts_*/
**/build/
**/build_*/
**/cmake-build-*/
**/output/
**/outputs/
**/work_dirs/
**/test/
**/tests/
**/data/
**/datasets/
**/ckpts/
**/*.engine
**/*.plan
**/*.pth
**/*.pt
**/*.ckpt
**/*.onnx
**/*.onnx.data
**/*.npz
**/*.npy
**/*.pkl
**/*.pickle
**/*.bin
**/*.so
**/*.so.*
**/*.a
**/*.o
**/*.cache
**/__pycache__/
**/*.py[cod]
**/*.log
**/*.pid

